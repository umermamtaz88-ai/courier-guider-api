APP_ENV=development
APP_NAME=CourierGuider
APP_VERSION=0.1.0
DEBUG=true

# Neon PostgreSQL (async driver)
DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# xAI Grok (Responses API)
LLM_PROVIDER=xai
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.6

# Embeddings (OpenAI-compatible or xAI)
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_BUCKET=uploads
OBJECT_STORAGE_LOCAL_PATH=./storage

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

MAX_UPLOAD_MB=25
RAG_TOP_K=20
RAG_FINAL_K=8

REALTIME_DATA_MAX_AGE_SECONDS=300
TRACKING_MAX_AGE_SECONDS=300
QUOTE_MAX_AGE_SECONDS=300
AVAILABILITY_MAX_AGE_SECONDS=1800

REDIS_URL=

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

LOG_LEVEL=INFO

# Web search (Tavily) — never expose keys to frontend
WEB_SEARCH_PROVIDER=mock
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
WEB_SEARCH_CACHE_HOURS=6
RAG_STALE_DAYS=90
